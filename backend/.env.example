APP_NAME=Tatlas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tatlas
DB_USERNAME=tatlas
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tatlas.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Tatlas -------------------------------------------------------------
# Public base URL used for share links / App Links (placeholder domain).
TATLAS_PUBLIC_URL=https://tatlas.app

# OpenStreetMap import (Overpass API). Bbox order: south,west,north,east.
# Default: Città Metropolitana di Bari.
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DEFAULT_BBOX="40.72,16.25,41.32,17.53"
OSM_OVERPASS_TIMEOUT=90
OSM_USER_AGENT="Tatlas/0.1 (OSM tattoo studio importer)"

# Geocoding (Photon). Replace with a self-hosted instance in production.
PHOTON_URL=https://photon.komoot.io
PHOTON_RATE_LIMIT_PER_MINUTE=30

# AI service (Phase 2)
AI_SERVICE_URL=http://ai-service:8001
